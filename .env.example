# ============================================================================
# 1. SERVER-SIDE ENVIRONMENT VARIABLES (Used when running `npm run dev` or `server.ts`)
# ============================================================================
# GEMINI_API_KEY: Required for Google Gemini AI resident & explorer conversations on the backend.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GROQ_API_KEY: Optional Groq LPU API key for ultra-fast City 2 & Explorer inference on the backend.
GROQ_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ============================================================================
# 2. OPTIONAL STATIC / GITHUB PAGES ENVIRONMENT VARIABLES
#    (Used if you deploy the frontend to GitHub Pages, Vercel, or Netlify)
# ============================================================================
# VITE_API_BASE_URL: If you host `server.ts` on Render/Railway, put its URL here
# (e.g. "https://gemini-city-server.onrender.com"). Leave empty if running on the same server or serverless.
VITE_API_BASE_URL=""

# VITE_GEMINI_API_KEY: Optional client-side Gemini key if hosting on static GitHub Pages without a backend server.
VITE_GEMINI_API_KEY=""

# VITE_GROQ_API_KEY: Optional client-side Groq key if hosting on static GitHub Pages without a backend server.
VITE_GROQ_API_KEY=""

